{
  "name": "avocado-web", "version": "0.2.0", "private": true, "type": "module",
  "engines": {"node": ">=22.12.0"},
  "scripts": {
    "dev": "concurrently -k \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --config client/vite.config.ts\"",
    "build": "tsc --noEmit && vite build --config client/vite.config.ts",
    "start": "node --env-file-if-exists=.env server/index.js",
    "db:migrate": "node --env-file-if-exists=.env server/migrate.js",
    "test": "node --test tests/*.test.js",
    "test:integration": "node --env-file-if-exists=.env --test tests/*.integration.js"
  },
  "dependencies": {"express": "^5.1.0", "pg": "^8.16.3", "react": "^19.1.0", "react-dom": "^19.1.0"},
  "devDependencies": {"@types/react": "^19.1.0", "@types/react-dom": "^19.1.0", "@types/node": "^24.0.0", "concurrently": "^9.2.0", "supertest": "^7.1.4", "typescript": "~5.9.3", "vite": "^8.0.0"}
}

{
  "name": "avocado-web",
  "version": "0.3.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "concurrently -k \"npm run api:dev\" \"npm run web:dev\"",
    "api:dev": ".venv/bin/python -m gunicorn --reload --workers 1 --config gunicorn.conf.py server.wsgi:app",
    "web:dev": "vite --config client/vite.config.ts",
    "build": "tsc --noEmit && vite build --config client/vite.config.ts",
    "start": ".venv/bin/python -m gunicorn --config gunicorn.conf.py server.wsgi:app",
    "db:migrate": ".venv/bin/python -m server.migrate",
    "test": ".venv/bin/python -m unittest discover -s tests -p \"test_*.py\"",
    "test:integration": ".venv/bin/python -m unittest discover -s tests -p \"test_postgres.py\""
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@types/node": "^24.0.0",
    "concurrently": "^9.2.0",
    "typescript": "~5.9.3",
    "vite": "^8.0.0"
  }
}

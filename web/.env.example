DATABASE_URL=postgresql://avocado:avocado_local@127.0.0.1:5432/avocado
HOST=127.0.0.1
PORT=3001
# Set to production behind HTTPS to require Secure session cookies.
AVOCADO_ENV=development
WEB_CONCURRENCY=2
# Free key: https://fdc.nal.usda.gov/api-key-signup/
# DEMO_KEY is limited to 30 requests/hour and 50/day per IP.
USDA_API_KEY=DEMO_KEY
# Websites on other origins allowed to call this API with bearer tokens (comma-separated),
# e.g. the GitHub Pages site: https://rohitdas2.github.io
ALLOWED_ORIGINS=
# Number of trusted reverse-proxy hops in front of Gunicorn (1 on Render); 0 when serving directly.
PROXY_HOPS=0
